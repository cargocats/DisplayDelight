{
  "multipart": [
    {
      "apply": {
        "model": "displaydelight:block/wood_support"
      },
      "when": {
        "support": "true"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/od_small_plated_elder_guardian_roll"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/od_small_plated_elder_guardian_roll",
        "y": 90
      },
      "when": {
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/od_small_plated_elder_guardian_roll",
        "y": 180
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/od_small_plated_elder_guardian_roll",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    }
  ]
}