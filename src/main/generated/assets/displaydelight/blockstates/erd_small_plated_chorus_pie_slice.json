{
  "multipart": [
    {
      "apply": {
        "model": "displaydelight:block/wood_support"
      },
      "when": {
        "support": "true"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/erd_small_plated_chorus_pie_slice"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/erd_small_plated_chorus_pie_slice",
        "y": 90
      },
      "when": {
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/erd_small_plated_chorus_pie_slice",
        "y": 180
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/erd_small_plated_chorus_pie_slice",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    }
  ]
}