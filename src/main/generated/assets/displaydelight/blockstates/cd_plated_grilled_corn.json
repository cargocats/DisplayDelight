{
  "multipart": [
    {
      "apply": {
        "model": "displaydelight:block/wood_support"
      },
      "when": {
        "support": "true"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_1"
      },
      "when": {
        "facing": "north",
        "stacks": "1"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_1",
        "y": 180
      },
      "when": {
        "facing": "south",
        "stacks": "1"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_1",
        "y": 90
      },
      "when": {
        "facing": "east",
        "stacks": "1"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_1",
        "y": 270
      },
      "when": {
        "facing": "west",
        "stacks": "1"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/wood_support"
      },
      "when": {
        "support": "true"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_2"
      },
      "when": {
        "facing": "north",
        "stacks": "2"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_2",
        "y": 180
      },
      "when": {
        "facing": "south",
        "stacks": "2"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_2",
        "y": 90
      },
      "when": {
        "facing": "east",
        "stacks": "2"
      }
    },
    {
      "apply": {
        "model": "displaydelight:block/cd_plated_grilled_corn_2",
        "y": 270
      },
      "when": {
        "facing": "west",
        "stacks": "2"
      }
    }
  ]
}